# ── RPC ───────────────────────────────────────────────────────────────────────
# Асиметрія навмисна: indexer читає мейннет, keeper пише в devnet.
# Один спільний ендпоінт тут ставити не можна — рано чи пізно його поставлять не туди.
MAINNET_RPC_URL=https://mainnet.helius-rpc.com/?api-key=REPLACE_ME
DEVNET_RPC_URL=https://devnet.helius-rpc.com/?api-key=REPLACE_ME

# ── База ──────────────────────────────────────────────────────────────────────
DATABASE_URL=postgres://user:password@host:5432/depin_reward_float

# Котирувань тут немає: індексатор бере їх із DefiLlama без ключа.

# ── Атестатор ─────────────────────────────────────────────────────────────────
# Приватний ключ ed25519, base58. Живе ТІЛЬКИ в процесі api.
# Хто ним володіє — видає будь-який ліміт. Ротація без переустановлення програми (FR-012c).
ATTESTOR_SECRET_KEY=REPLACE_ME
ATTESTOR_PUBLIC_KEY=REPLACE_ME

# ── Кіпер ─────────────────────────────────────────────────────────────────────
KEEPER_SECRET_KEY=REPLACE_ME

# ── Програма ──────────────────────────────────────────────────────────────────
PROGRAM_ID=REPLACE_ME
STABLE_MINT=REPLACE_ME
# Mint authority of the devnet HONEY and HNT stand-ins, the key the demo pays rewards
# with. Its own key, not the deployer: whoever runs the demo must not be able to upgrade
# the program. `pnpm seed:reward-mints` creates the mints and prints VITE_REWARD_MINTS.
REWARD_MINT_AUTHORITY=REPLACE_ME
# Rate attestations (FR-015b): Jupiter prices the mainnet token, MAINNET_RPC_URL dates
# the price by its block, and the api signs the rate for the devnet stand-in listed
# here, in the format of VITE_REWARD_MINTS. All three or none. Key: portal.jup.ag.
JUPITER_API_KEY=
REWARD_MINTS=

# ── API ───────────────────────────────────────────────────────────────────────
PORT=8787
LOG_LEVEL=info
# Походження сторінки, якій дозволено читати api. Кілька — через кому.
WEB_ORIGIN=http://localhost:5173

# ── Web ───────────────────────────────────────────────────────────────────────
# Куди сторінка ходить за історією і лімітом. Читається під час збірки, тож
# потрапляє у бандл — секретів тут бути не може.
VITE_API_URL=http://localhost:8787
# Borrowing reads the pool and sends the loan here, from the browser. Everything in a
# VITE_ variable is public, so no key-bearing RPC URL: the public devnet endpoint is
# the default.
VITE_DEVNET_RPC_URL=https://api.devnet.solana.com
# The stablecoin the pool lends; unset, the borrow page says lending is not set up.
VITE_STABLE_MINT=
# HONEY and HNT do not exist on devnet: one devnet stand-in mint per network, as
# hivemapper:<mint>,helium:<mint>. A network without one cannot back a loan.
VITE_REWARD_MINTS=
