{
  "name": "depin-reward-float",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@9.15.0",
  "engines": {
    "node": ">=24.2"
  },
  "scripts": {
    "build": "pnpm -r run build",
    "test": "pnpm -r run test",
    "typecheck": "pnpm -r run typecheck",
    "lint": "biome lint .",
    "lint:fix": "biome check --write .",
    "format": "biome format --write .",
    "gate": "pnpm idl:check && pnpm lint && pnpm typecheck && pnpm test",
    "idl:sync": "node scripts/sync-idl.mjs",
    "idl:check": "node scripts/sync-idl.mjs --check",
    "bench:limit": "pnpm --filter @drf/tests bench:limit",
    "seed:pool": "pnpm --filter @drf/anchor-client seed:pool"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.11",
    "@types/node": "^26.4.0",
    "typescript": "^7.0.2",
    "vitest": "^4.1.11"
  }
}
