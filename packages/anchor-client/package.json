{
  "name": "@drf/anchor-client",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "seed:conversion-vaults": "node --env-file-if-exists=../../.env scripts/seed-conversion-vaults.ts",
    "seed:pool": "node --env-file-if-exists=../../.env scripts/seed-pool.ts",
    "seed:reward-mints": "node --env-file-if-exists=../../.env scripts/seed-reward-mints.ts",
    "test": "vitest run --passWithNoTests",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.scripts.json"
  },
  "dependencies": {
    "@coral-xyz/anchor": "^0.32.1",
    "@drf/shared": "workspace:^",
    "@solana/web3.js": "^1.98.4",
    "zod": "^4.5.2"
  }
}
