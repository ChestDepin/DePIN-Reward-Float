    "@drf/shared": "workspace:^",
    "@scure/base": "^2.4.0",
    "@solana/web3.js": "^1.98.4",
    "drizzle-orm": "^0.44.7",
    "zod": "^4.5.2"
  },
  "devDependencies": {
    "@drf/web": "workspace:^",
    "@hono/node-server": "^1.19.9",
    "playwright": "^1.62.1",
    "vite": "^8.2.2"
  }
