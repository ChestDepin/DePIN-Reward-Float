{
  "name": "@drf/tests",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run --passWithNoTests",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "bench:limit": "vitest run --config vitest.bench.config.ts limit-latency first-screen-latency",
    "bench:borrow": "vitest run --config vitest.bench.config.ts borrow-latency"
